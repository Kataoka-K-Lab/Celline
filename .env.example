# Celline Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# AI Metadata Extraction
# ============================================
# Choose ONE of the following AI providers:

# OpenAI API Key (for GPT-4o)
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude API Key (for Claude 3.5 Sonnet)
# Get your key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-claude-api-key-here

# Note: If both keys are provided, OpenAI will be used by default
# You can specify which provider to use with --ai-provider flag

# ============================================
# Usage Examples
# ============================================
# Enable AI metadata extraction when adding samples:
#   celline run add GSM123456 --ai
#   celline run add GSM123456 --ai --ai-provider=claude
#   celline run add GSM123456 --ai --ai-provider=openai

# Generate metadata report with AI analysis:
#   celline run export_metareport --ai
